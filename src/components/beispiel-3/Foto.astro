---
// Steht dort, wo später ein echtes Foto des Kunden hinkommt. Nur Kreisflächen im Farbton der Seite, ohne Beschriftung.
---
<div class="foto-platz" aria-hidden="true">
  <svg viewBox="0 0 300 800" preserveAspectRatio="xMidYMid slice" focusable="false">
    <rect class="fp-grund" width="300" height="800" />
    <circle class="fp-a" cx="300" cy="130" r="170" />
    <circle class="fp-b" cx="0" cy="470" r="210" />
    <circle class="fp-c" cx="215" cy="690" r="95" />
  </svg>
</div>
