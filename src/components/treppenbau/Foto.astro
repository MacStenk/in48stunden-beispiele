  <svg viewBox="0 0 400 300" focusable="false">
    <rect class="fp-grund" width="400" height="300" />
    <path class="fp-linie" d="M0 240h90v-40h70v-40h70v-40h70v-40h100" />
    <path class="fp-linie fp-fein" d="M90 240v60M160 200v100M230 160v140M300 120v180" />
    <circle class="fp-sonne" cx="330" cy="62" r="26" />
  </svg>
</div>
